; Engine configuration file.
; Capy Tower Wars — portrait tower conquest.

config_version=5

[application]

config/name="Capy Tower Wars"
config/description="A short portrait game about capybara soldiers taking towers."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/sprites/icon.png"

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"
AudioHooks="*res://scripts/autoload/audio_hooks.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
